{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api.main:app"
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "OPEN_NOTEBOOK_API_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/search/ask",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/sources/:sourceId/chat/sessions/:sessionId/messages",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/:path*",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
